# Copy to .env and edit. Never commit .env.

# --- Storage ---
# Baseline node state. docker compose overrides this to redis://redis:6379/0
DATAPULSE_REDIS_URL=redis://localhost:6379/0

# Event log for the metrics dashboard.
DATAPULSE_DB_PATH=/data/datapulse_events.db

# --- Security ---
# Protects /api/nodes. CHANGE THIS before exposing the service.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
DATAPULSE_API_KEY=change-me

# Comma-separated origins allowed to call the API from a browser.
# Use the exact dashboard origin in production instead of '*'.
DATAPULSE_ALLOWED_ORIGINS=*

# --- Licensing ---
# How many syncs before the free tier returns 402.
DATAPULSE_FREE_TIER_LIMIT=10000

# Paste the Ed25519-signed key you received after purchase.
DATAPULSE_LICENSE_KEY=

# --- Limits ---
DATAPULSE_MAX_STATE_DEPTH=32
DATAPULSE_MAX_STATE_BYTES=1048576
DATAPULSE_MAX_BATCH=500
DATAPULSE_ALLOW_MEMORY_FALLBACK=1

# --- Sales ---
DATAPULSE_PURCHASE_URL=

# --- Optional alerting ---
# DATAPULSE_ALERT_URL=https://hooks.example.com/izgon
# DATAPULSE_ALERT_AFTER=300
# DATAPULSE_ALERT_EVERY=30

# --- Optional adaptive polling advice ---
# DATAPULSE_ADAPTIVE=1
# DATAPULSE_QUIET_AFTER=3
# DATAPULSE_MAX_INTERVAL=300
# DATAPULSE_INTERVAL_FACTOR=2
