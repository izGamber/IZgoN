# Copy to .env and edit. Never commit .env.

# --- Storage ---
# Baseline node state. docker compose overrides this to redis://redis:6379/0
DATAPULSE_REDIS_URL=redis://localhost:6379/0

# Event log for the metrics dashboard.
DATAPULSE_DB_PATH=/data/datapulse_events.db

# --- Security ---
# Protects /api/nodes. CHANGE THIS before exposing the service.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DATAPULSE_API_KEY=change-me

# Comma-separated origins allowed to call the API from a browser.
# "*" is fine locally, narrow it in production.
DATAPULSE_ALLOWED_ORIGINS=*

# --- Licensing ---
# How many syncs before the free tier returns 402.
# 10000 is enough for a real evaluation; 100 is not.
DATAPULSE_FREE_TIER_LIMIT=10000

# Paste the key you received after purchase.
DATAPULSE_LICENSE_KEY=

# HMAC secret used to validate the key offline.
# Keep the same value you used when generating keys. NEVER commit this.
DATAPULSE_LICENSE_SECRET=

# --- Sales ---
# Checkout link shown when the free tier runs out.
DATAPULSE_PURCHASE_URL=
